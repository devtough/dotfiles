{{- /*
  Machine profile. Asked once at `chezmoi init` and stored in
  ~/.config/chezmoi/chezmoi.toml, so later apply/update runs never re-prompt.

    rss-mac   macOS + nix-darwin, oh-my-zsh + powerlevel10k
    sonbox    macOS, homebrew only (no nix), minimal hand-rolled zsh
    omarchy   Arch + omarchy, bash

  Templates branch on .profile for per-machine differences and keep
  .chezmoi.os for what really is just "mac vs linux" (pbcopy vs wl-copy, etc).

  promptChoiceOnce validates against the list, so a typo fails at init instead
  of silently falling through to another machine's branch. Its args are
  (dict, data key, prompt text, choices) — and the prompt text doubles as the
  --promptChoice key, so keep it exactly "profile". Non-interactive init:

    chezmoi init --source=~/Projects/dotfiles --promptChoice profile=sonbox
*/ -}}
{{- $profile := promptChoiceOnce . "profile" "profile" (list "rss-mac" "sonbox" "omarchy") -}}

# Generated by chezmoi init from .chezmoi.toml.tmpl — edit that, not this.

# Recorded so chezmoi keeps using whichever checkout `init --source` pointed at
# instead of defaulting back to ~/.local/share/chezmoi.
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
    profile = {{ $profile | quote }}
