{{ if eq .profile "rss-mac" -}}
# oh-my-zsh + powerlevel10k stack. rss-mac only — sonbox runs a minimal zsh
# with no framework, omarchy runs bash.
[".oh-my-zsh"]
    type = "git-repo"
    url = "https://github.com/ohmyzsh/ohmyzsh.git"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh-custom/plugins/zsh-syntax-highlighting"]
    type = "git-repo"
    url = "https://github.com/zsh-users/zsh-syntax-highlighting.git"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh-custom/plugins/zsh-history-substring-search"]
    type = "git-repo"
    url = "https://github.com/zsh-users/zsh-history-substring-search.git"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".oh-my-zsh-custom/themes/powerlevel10k"]
    type = "git-repo"
    url = "https://github.com/romkatv/powerlevel10k.git"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

{{ end -}}

[".config/tmux/plugins/tpm"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tpm.git"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

# Session persistence. Managed here rather than through `prefix + I` so a fresh
# machine gets them from `chezmoi apply` alone. Declared in tmux.conf via
# @plugin so tpm sources them.
[".config/tmux/plugins/tmux-resurrect"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tmux-resurrect.git"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[".config/tmux/plugins/tmux-continuum"]
    type = "git-repo"
    url = "https://github.com/tmux-plugins/tmux-continuum.git"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"
