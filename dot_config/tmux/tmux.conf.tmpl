set -g default-terminal "tmux-256color"
set -ag terminal-overrides ",xterm-256color:RGB"
{{ if eq .chezmoi.os "darwin" -}}
set -ag terminal-features 'xterm-ghostty:UTF-8:RGB'

# Claude Code compatibility
set -g focus-events on       # pass focus events to TUI apps (fixes Claude Code scroll/cursor glitches in tmux)
set -g allow-passthrough on  # let escape sequences reach outer terminal (Claude Code notifications, progress bar)
set -sg escape-time 0        # remove ESC delay (faster vim mode switching)

set -g mouse on

# switch to another session instead of detaching when session/window is killed
set -g detach-on-destroy off

{{ else }}
set -g mouse on

# Clipboard / extended keys (omarchy defaults the migration couldn't insert)
set -g allow-passthrough on
set -g set-clipboard on
set -g extended-keys on
set -g extended-keys-format csi-u
set -sg escape-time 10

{{ end -}}
# set shell
{{ if eq .chezmoi.os "darwin" -}}
set -g default-shell /bin/zsh
# Run it as a login shell so /etc/zprofile -> path_helper runs and /usr/bin
# (sudo, dig, dscacheutil, ...) ends up in PATH. Without this every pane
# inherits whatever PATH the tmux server was started with — usually broken.
set -g default-command "${SHELL} -l"
{{ else -}}
set -g default-shell /bin/bash
{{ end -}}

# auto renumber windows when one closes
set-option -g renumber-windows on

# Smart pane switching with awareness of Vim splits.
# See: https://github.com/christoomey/vim-tmux-navigator
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
    | grep -iqE '^[^TXZ ]+ +(\\S+\\/)?g?(view|l?n?vim?x?|fzf)(diff)?$'"
bind-key -n 'C-h' if-shell "$is_vim" 'send-keys C-h'  'select-pane -L'
bind-key -n 'C-j' if-shell "$is_vim" 'send-keys C-j'  'select-pane -D'
bind-key -n 'C-k' if-shell "$is_vim" 'send-keys C-k'  'select-pane -U'
bind-key -n 'C-l' if-shell "$is_vim" 'send-keys C-l'  'select-pane -R'
tmux_version='$(tmux -V | sed -En "s/^tmux ([0-9]+(.[0-9]+)?).*/\1/p")'
if-shell -b '[ "$(echo "$tmux_version < 3.0" | bc)" = 1 ]' \
    "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\'  'select-pane -l'"
if-shell -b '[ "$(echo "$tmux_version >= 3.0" | bc)" = 1 ]' \
    "bind-key -n 'C-\\' if-shell \"$is_vim\" 'send-keys C-\\\\'  'select-pane -l'"

bind-key -T copy-mode-vi 'C-h' select-pane -L
bind-key -T copy-mode-vi 'C-j' select-pane -D
bind-key -T copy-mode-vi 'C-k' select-pane -U
bind-key -T copy-mode-vi 'C-l' select-pane -R
bind-key -T copy-mode-vi 'C-\' select-pane -l

{{ if eq .chezmoi.os "darwin" -}}
# Alt+hjkl: resize panes by 1.
# Guarded by $is_vim exactly like the C-hjkl binds above. Without the guard
# these root-table binds swallow M-hjkl before nvim ever sees it, which left
# nvim's smart-splits resize keymaps unreachable inside tmux. The linux branch
# never had this problem because this block is macOS-only.
bind -n M-k if-shell "$is_vim" 'send-keys M-k' 'resize-pane -U 1'
bind -n M-j if-shell "$is_vim" 'send-keys M-j' 'resize-pane -D 1'
bind -n M-h if-shell "$is_vim" 'send-keys M-h' 'resize-pane -L 1'
bind -n M-l if-shell "$is_vim" 'send-keys M-l' 'resize-pane -R 1'

{{ end -}}
# increase history and set vi mode
set-option -g history-limit 50000
setw -g mode-keys vi
unbind-key [
{{ if eq .chezmoi.os "darwin" -}}
bind-key C-v copy-mode

{{ else -}}
bind-key v copy-mode

# vim-style selection + yank to the system clipboard (Wayland: wl-copy)
bind-key -T copy-mode-vi v   send-keys -X begin-selection
bind-key -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind-key -T copy-mode-vi y   send-keys -X copy-pipe-and-cancel "wl-copy"
# Y = "yy": yank the whole current line
bind-key -T copy-mode-vi Y   send-keys -X start-of-line \; \
                             send-keys -X begin-selection \; \
                             send-keys -X end-of-line \; \
                             send-keys -X copy-pipe-and-cancel "wl-copy"
# also send mouse-drag selections to wl-copy
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "wl-copy"

{{ end -}}
# prefix key: Control A
set-option -g prefix C-a

{{ if eq .chezmoi.os "darwin" -}}
# copy current pane's working directory to clipboard
bind y run-shell "tmux display-message -p '#{pane_current_path}' | pbcopy && tmux display-message 'Copied: #{pane_current_path}'"

{{ end -}}
# split tmux panes
unbind-key -
bind - split-window -v -c "#{pane_current_path}"
unbind-key |
bind | split-window -h -c "#{pane_current_path}"

{{ if eq .chezmoi.os "darwin" -}}
# split with Claude Code (--dangerously-skip-permissions)
bind _ split-window -v -c "#{pane_current_path}" "claude --dangerously-skip-permissions --chrome"
bind '\' split-window -h -c "#{pane_current_path}" "claude --dangerously-skip-permissions --chrome"

# new windows open in current pane's directory
bind c new-window -c "#{pane_current_path}"

# -----------------------------------------------------------------------------
# fzf / scratch popups. All guarded by the server-global @popup_open flag so
# only ONE is open at a time: a binding refuses while the flag is set, sets it
# on open, and clears it when the popup's command exits (covers fzf-cancel,
# detach, and exit). If popups ever stop opening after a hard kill, reset with:
#     tmux set -g @popup_open 0
#
# Both pickers preview through scripts/peek-preview.sh, which trims the blank
# rows capture-pane pads to the bottom of a pane and shows the last screenful
# of real output, so the preview opens at the END of the buffer, not the top.
# -----------------------------------------------------------------------------

# Fuzzy-JUMP to any window across ALL sessions, then switch to it (prefix + j).
# First field of each line is the session:window target; switch-client hops
# sessions + selects the window in one shot.
bind j if-shell -F '#{@popup_open}' {
    display-message 'a popup is already open'
} {
    set -g @popup_open 1
    display-popup -E -w 70% -h 70% "tmux list-windows -a -F '#{session_name}:#{window_index}  #{window_name}  [#{pane_current_command}]' | fzf --reverse --no-sort --preview '~/.config/tmux/scripts/peek-preview.sh {1}' --preview-window=down:60% | awk '{print \$1}' | xargs -r tmux switch-client -t ; tmux set -g @popup_open 0"
}

# Dedicated 'claude' scratch session in a popup, TOGGLE (prefix + C-p).
# Press from anywhere to open; press again inside it to close (detach). Hold as
# many conversations as you like as windows inside it (C-a c / C-a n/p).
# detach-on-destroy on (set per-open) means typing `exit` in the last window
# closes the popup cleanly instead of switching to a stray session.
bind C-p if-shell -F '#{==:#{session_name},claude}' {
    detach-client
} {
    if-shell -F '#{@popup_open}' {
        display-message 'a popup is already open'
    } {
        set -g @popup_open 1
        display-popup -w 85% -h 85% -E "tmux new-session -d -s claude 2>/dev/null; tmux set-option -t claude detach-on-destroy on; TMUX= tmux attach -t claude; tmux set -g @popup_open 0"
    }
}

# Fuzzy-PEEK any window in a popup, then detach to close (prefix + P).
# Same picker as 'prefix j', but attaches a throwaway client in the popup
# instead of switching. Detach (C-a d) and your underlying window is unchanged:
# the session's current window is saved before select-window and restored after
# the popup client exits, and the peek client attaches with -f ignore-size so it
# does not drag the session down to the popup's 85% size while it is open.
bind P if-shell -F '#{@popup_open}' {
    display-message 'a popup is already open'
} {
    set -g @popup_open 1
    display-popup -w 85% -h 85% -E 'target=$(tmux list-windows -a -F "#{session_name}:#{window_index}  #{window_name}  [#{pane_current_command}]" | fzf --reverse --no-sort --preview "~/.config/tmux/scripts/peek-preview.sh {1}" --preview-window=down:60% | awk "{print \$1}"); if [ -n "$target" ]; then sess="${target%%:*}"; orig=$(tmux display-message -p -t "$sess" "#{window_index}"); tmux select-window -t "$target"; TMUX= tmux attach -f ignore-size -t "$sess"; tmux select-window -t "$sess:$orig"; fi; tmux set -g @popup_open 0'
}

# Fuzzy-switch by AGENT STATE across all sessions (prefix + a).
# Same picker UX as 'prefix j', but rows come from vox (:8282, attention-ranked:
# blocked > done-unseen > working > idle) and show live state
# (▲blocked ✓done ●working ○idle). Successor to agent-tracker's agent-switch.
