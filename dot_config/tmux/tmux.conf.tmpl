set -g status-left-length 50
set -g status-right-length 150

set -g status-left "#[bg=#82aaff,fg=#011627,bold] #S #[bg=#011627,fg=#82aaff]"

{{ if eq .profile "sonbox" -}}
# No kubectl or rpk on this machine, so the K8/RPK segments would just render
# "no kubectl"/blank every status-interval. Add them back if those land here.
set -g status-right "\
#[fg=#687686]│ \
#[fg=#c5e478]CPU #(~/.config/tmux/scripts/cpu.sh) \
#[fg=#687686]│ \
#[fg=#21c7a8]RAM #(~/.config/tmux/scripts/ram.sh) "
{{ else -}}
set -g status-right "\
#[fg=#687686]│ \
#[fg=#c5e478]CPU #(~/.config/tmux/scripts/cpu.sh) \
#[fg=#687686]│ \
#[fg=#21c7a8]RAM #(~/.config/tmux/scripts/ram.sh) \
