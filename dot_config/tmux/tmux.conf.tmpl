# -----------------------------------------------------------------------------
# fzf / scratch popups. All guarded by the server-global @popup_open flag so
# only ONE is open at a time: a binding refuses while the flag is set, sets it
# on open, and clears it when the popup's command exits (covers fzf-cancel,
# detach, and exit). If popups ever stop opening after a hard kill, reset with:
#     tmux set -g @popup_open 0
#
# Both pickers preview through scripts/peek-preview.sh, which trims the blank
# rows capture-pane pads to the bottom of a pane, and open the preview window
# with fzf's `follow` flag, which anchors it to the last line it was given. The
# trim is what makes follow land on real output instead of on the padding. The
# scroll indicator in the preview's top-right corner reads as an offset into
# the history (e.g. 39/60) rather than the 1/N that made a preview already
# sitting at the end look like it was parked at the top.
# -----------------------------------------------------------------------------

# Fuzzy-JUMP to any window across ALL sessions, then switch to it (prefix + j).
# First field of each line is the session:window target; switch-client hops
# sessions + selects the window in one shot.
bind j if-shell -F '#{@popup_open}' {
    display-message 'a popup is already open'
} {
    set -g @popup_open 1
    display-popup -E -w 70% -h 70% "tmux list-windows -a -F '#{session_name}:#{window_index}  #{window_name}  [#{pane_current_command}]' | fzf --reverse --no-sort --preview '~/.config/tmux/scripts/peek-preview.sh {1}' --preview-window=down:60%,follow | awk '{print \$1}' | xargs -r tmux switch-client -t ; tmux set -g @popup_open 0"
}

# Dedicated 'claude' scratch session in a popup, TOGGLE (prefix + C-p).
# Press from anywhere to open; press again inside it to close (detach). Hold as
# many conversations as you like as windows inside it (C-a c / C-a n/p).
# detach-on-destroy on (set per-open) means typing `exit` in the last window
# closes the popup cleanly instead of switching to a stray session.
bind C-p if-shell -F '#{==:#{session_name},claude}' {
    detach-client
} {
    if-shell -F '#{@popup_open}' {
        display-message 'a popup is already open'
    } {
        set -g @popup_open 1
        display-popup -w 85% -h 85% -E "tmux new-session -d -s claude 2>/dev/null; tmux set-option -t claude detach-on-destroy on; TMUX= tmux attach -t claude; tmux set -g @popup_open 0"
    }
}

# Fuzzy-PEEK any window in a popup, then detach to close (prefix + P).
# Same picker as 'prefix j', but attaches a throwaway client in the popup
# instead of switching. Detach (C-a d) and your underlying window is unchanged:
# the session's current window is saved before select-window and restored after
# the popup client exits, and the peek client attaches with -f ignore-size so it
# does not drag the session down to the popup's 85% size while it is open.
bind P if-shell -F '#{@popup_open}' {
    display-message 'a popup is already open'
} {
    set -g @popup_open 1
    display-popup -w 85% -h 85% -E 'target=$(tmux list-windows -a -F "#{session_name}:#{window_index}  #{window_name}  [#{pane_current_command}]" | fzf --reverse --no-sort --preview "~/.config/tmux/scripts/peek-preview.sh {1}" --preview-window=down:60%,follow | awk "{print \$1}"); if [ -n "$target" ]; then sess="${target%%:*}"; orig=$(tmux display-message -p -t "$sess" "#{window_index}"); tmux select-window -t "$target"; TMUX= tmux attach -f ignore-size -t "$sess"; tmux select-window -t "$sess:$orig"; fi; tmux set -g @popup_open 0'
}

# Fuzzy-switch by AGENT STATE across all sessions (prefix + a).
# Same picker UX as 'prefix j', but rows come from vox (:8282, attention-ranked:
# blocked > done-unseen > working > idle) and show live state
# (▲blocked ✓done ●working ○idle). Successor to agent-tracker's agent-switch.
# DISABLED 2026-08-04: vox moved off this machine (repo: github.com/devtough/vox,
# local dirs archived in ~/Sandbox/2026-08-04-archive). To re-enable, point the
# display-popup at a live checkout's bin/vox-switch.
