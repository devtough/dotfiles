# The window list carries the same three glyphs as the rollup, so "2 things
# need you" on the right has a "these two windows" to point at. It is a pure
# format: every writer of pane state already rolls the loudest pane in a window
# up into @corral_win_state, so this costs nothing on redraw and never polls.
#
# It answers "where" only inside the session you are looking at -- the window
# list has no rows for the other sessions. `prefix + a` is the cross-session
# answer, and the rollup is what tells you to go looking in the first place.
#
# Stale has no glyph here on purpose. @corral_win_state is written from raw pane
# states by the hook's fast path, which has no clock to age them against; a pane
# that reads "working" here may be stale, and the rollup is where that gets told
# apart. One ● that is occasionally optimistic beats teaching the fast path to
# do arithmetic on every transition.
# Held in an option and read back with #{E:...}, which expands a value as a
# format rather than printing it -- so the conditionals below are evaluated
# against each window's own @corral_win_state, and the two window-status formats
# share one definition instead of carrying a copy each. (tmux.conf has no shell
# variables; "$foo" here would be an unknown command, not a substitution.)
set -g @corral_win_glyph "#{?#{==:#{@corral_win_state},blocked},#[fg=#ef5350] ▲,}#{?#{==:#{@corral_win_state},done},#[fg=#22da6e] ✓,}#{?#{==:#{@corral_win_state},working},#[fg=#687686] ●,}"
set -g window-status-format "#[fg=#687686] #I:#W#{E:@corral_win_glyph}#[default] "
set -g window-status-current-format "#[bg=#1d3b53,fg=#82aaff,bold] #I:#W#{E:@corral_win_glyph}#[bg=#1d3b53,fg=#82aaff] "
set -g window-status-separator ""

# Window names. The stock automatic-rename-format is #{pane_current_command},
# which says nothing useful about a pane running an agent: Claude Code rewrites
# its argv to its version, so every Claude window read "2.1.238". Each agent is
# handled by what it actually advertises.
#
# Claude sets its pane title to the task it is on ("* Databricks connector"), so
# use that, minus the marker, capped at 24 chars to keep the status bar sane.
#
# Codex sets a title too, but it is no use: "<braille spinner> <cwd basename>"
# while codex renders and a stale shell title while it does not, already
# ellipsis-truncated by codex, and stripping the spinner with a format regex eats
# a character (tmux substitutes over bytes, the spinner is 3). So codex panes name
# themselves off the directory instead. Dirs under ~/Work/tries are date-stamped,
# which is the least interesting part of the name, so drop the leading YYYY-MM-DD:
# 2026-08-25-shared-drive-stats reads as "shared-drive-stats". The date classes are
# spelled out because a {4} repeat would close the #{...} at its first brace --
# that failure is silent and leaks regex fragments into the window name. Codex
# carries no task in its title by default; adding task-progress to terminal_title
# in ~/.codex/config.toml would give it one, worth switching this branch back for.
#
# Anything else keeps the command name. Copy mode is a suffix rather than a
# replacement: tmux's stock format swaps the whole name for "[tmux]" the moment a
# pane enters copy mode, which blanked the task out of the status bar on scroll.
#
# This all follows the ACTIVE pane, so the name changes as you move between panes.
# `prefix ,` and `prefix N` win over it: a manual rename turns automatic-rename off
# for that window, and the name then sticks until you set it back on.
set -g automatic-rename-format "#{?#{==:#{pane_current_command},codex},#{=24:#{s/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-//:#{b:pane_current_path}}},#{?#{m:✳*,#{pane_title}},#{=24:#{s/^✳ //:pane_title}},#{pane_current_command}}}#{?pane_in_mode,[^],}#{?pane_dead,[dead],}"

# `prefix w` (choose-tree) renders PANE rows with #{pane_current_command}, which
# is the same "2.1.238" junk automatic-rename-format works around. Give it an
# explicit -F that applies the Claude-title rule to pane rows; window rows keep
# the stock #{window_name}#{window_flags} and so pick up the names set above.
bind w choose-tree -Zw -F "#{?pane_format,#{?pane_marked,#[reverse],}#{?#{m:✳*,#{pane_title}},#{s/^✳ //:pane_title},#{pane_current_command}}#{?pane_active,*,}#{?pane_marked,#[default],},#{?window_format,#{window_name}#{window_flags},#{session_name}: #{session_windows} windows}}"

# Generated names (~/.local/bin/tmux-name). automatic-rename can only echo what
# a pane advertises; these read what is actually on screen and ask a model for a
# name. prefix N names the window, prefix S the session. Both are manual renames,
# so they turn automatic-rename off for that window and the name then sticks.
bind N display-message "naming window..." \; run-shell -b "~/.local/bin/tmux-name window '#{session_name}:#{window_index}'"
bind S display-message "naming session..." \; run-shell -b "~/.local/bin/tmux-name session '#{session_name}'"

set -g pane-border-style "fg=#687686"
set -g pane-active-border-style "fg=#82aaff"

set -g message-style "bg=#1d3b53,fg=#d6deeb"
set -g message-command-style "bg=#1d3b53,fg=#d6deeb"

set -g mode-style "bg=#1d3b53,fg=#d6deeb"

set -g clock-mode-colour "#82aaff"
{{ else -}}
# Colors are auto-generated from the active omarchy palette by
# ~/.config/omarchy/hooks/theme-set into omarchy-theme.conf (sourced below),
# and regenerated on every `omarchy theme set`. Don't hand-edit the colors here.
source-file ~/.config/tmux/omarchy-theme.conf
{{ end -}}

# =============================================================================
# Plugins
# =============================================================================
# Checkouts are managed by chezmoi (.chezmoiexternal.toml.tmpl), not by
# `prefix + I` — tpm only sources what is already on disk. Declared with the
# modern @plugin form; the old @tpm_plugins variable is deprecated upstream.
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'   # must be declared after resurrect

# --- persistence across server restarts and reboots --------------------------
# resurrect saves the session/window/pane tree with per-pane cwd; continuum runs
# it on a timer and replays the last save when the server starts.
#
# capture-pane-contents replays scrollback into restored panes. It captures up
# to 'history-limit' (50000 above) per pane, which is roughly 6MB of staging per
# full pane on every save. Disk does not accumulate: pane contents go to a
# single fixed-name pane_contents.tar.gz, and save.sh's remove_old_backups()
# prunes dumps past 30 days while keeping the last 5. Shorten that window with
# @resurrect-delete-backup-after if it ever matters.
set -g @resurrect-capture-pane-contents 'on'

# Minutes, integer; 0 disables. continuum does `interval * 60` in $(( )), so
# sub-minute values are not expressible at all -- 1 is the floor.
#
# Left at upstream's 15 deliberately. Cost is not the reason: measured here on
# 12 panes, a save is ~0.13s + ~42ms/pane for metadata, plus ~75ms/pane again
# when a pane is at the full 50000-line history-limit -- ~2s of backgrounded
# work in the worst case, and it never blocks the server. The reason is
# resurrect #576/#578: a save landing while the server is starting or stopping
# writes an empty dump and repoints 'last' at it, so @continuum-restore then
# restores nothing. Both issues are open and upstream has not shipped a commit
# since Aug 2024, so shortening the interval just buys more rolls of that dice.
#
# `prefix + C-s` saves on demand when you want a checkpoint now. If write
# volume ever becomes the concern instead, @resurrect-pane-contents-area
# 'visible' captures the screen rather than the whole scrollback.
set -g @continuum-save-interval '15'
set -g @continuum-restore 'on'

# Install continuum's autosave hook ourselves, because continuum will not.
#
# continuum.tmux only calls add_resurrect_save_interpolation() when
# `! another_tmux_server_running`, and that check is not "another tmux SERVER" —
# helpers.sh greps `ps -u $UID -o "command pid"` for every process whose command
# starts with "tmux", then trips if the count exceeds 1 at startup. This machine
# runs a launchd-managed `tmux -S /tmp/cdxprobe/p.sock` for codex, which pushes
# the count to 2, so autosave was silently never installed. Verified: resurrect
# bound its keys, continuum set no @continuum-save-last-timestamp, and
# status-right had no interpolation.
#
# Appending the exact same string continuum would have used means its own
# presence check (a substring test) finds it and skips, so this never
# double-installs. @continuum-restore is unaffected either way — the restore
# path sits outside that guard.
#
# The guard exists so two tmux servers do not clobber each other's dump. That
# risk does not apply here: the codex servers run `-f /dev/null`, so they load
# no plugins and never save. If you ever run a second REAL tmux server, give it
# its own @resurrect-dir or this will race.
set -ag status-right "#({{ .chezmoi.homeDir }}/.config/tmux/plugins/tmux-continuum/scripts/continuum_save.sh)"

# Process restore is left at resurrect's defaults, which is a conservative list:
# vi vim nvim emacs man less more tail top htop irssi weechat mutt. Anything
# else -- claude, ssh, dev servers -- comes back as a plain shell in the right
# directory. Add to that with @resurrect-processes.

# --- corral: agent tracking, and an agent-aware restore ----------------------
# resurrect brings the pane tree back with the right cwd, but an agent pane
# comes back as a bare shell: claude rewrites its argv to "claude", so nothing
# in the dump records which conversation the pane was holding. corral keeps that
# missing piece -- Claude Code hooks push per-pane state into tmux pane options
# (@corral_state/@corral_agent/@corral_session) and the session id into
# ~/.local/state/corral -- then snapshots it from resurrect's own post-save hook
# so both files describe the same instant, and replays `claude --resume <id>`
# into the matching pane after resurrect restores. `corral doctor` checks the
# whole chain; `corral list` shows what is running where.
#
# --detach because post-restore-all runs synchronously inside resurrect: the
# wait for restored login shells to reach a prompt, and the stagger between
# launches, have to happen out of its way.
set -g @resurrect-hook-post-save-all '{{ .chezmoi.homeDir }}/.local/bin/corral save >/dev/null 2>&1'
set -g @resurrect-hook-post-restore-all '{{ .chezmoi.homeDir }}/.local/bin/corral restore --detach >/dev/null 2>&1'

# Looking at a pane that finished clears its "done, unseen" badge. focus-events
# is already on (Claude Code needs it), so this costs nothing extra.
set-hook -g pane-focus-in 'run-shell -b "{{ .chezmoi.homeDir }}/.local/bin/corral seen #{pane_id}"'

# An agent that is killed rather than exited leaves its last state behind, and
# records outlive their panes. Reconcile both when a pane goes away.
set-hook -g pane-exited 'run-shell -b "{{ .chezmoi.homeDir }}/.local/bin/corral refresh"'

# --- the rollup: every agent on the server, in one segment -------------------
# One line for the whole machine, not per-window -- the point of it is that you
# do not have to be in the right window to know an agent wants you. It counts
# panes, not agents by name: claude and codex land in the same buckets, because
# what you act on is "something is blocked", not "a codex is blocked".
#
#   ▲n  blocked, wants input      ●n  working
#   ✓n  done and not looked at    ⚠n  stale: claims to be working, stopped
#                                     reporting -- killed, or wedged
#
# Idle is not shown, and the segment renders as nothing at all when no agent
# needs you. The conditional below is what makes that true down to the
# separator: an empty rollup must not leave a dangling "│" behind.
#
# This is a plain format, not a #() job. Reading a tmux option costs no process
# on redraw and updates the instant the option is written, for every attached
# client at once; corral-hook writes it on the exact transition, so the bar
# changes as the agent changes rather than up to status-interval later.
set -ag status-right "#{?@corral_rollup,#[fg=#687686]│ #{@corral_rollup} ,}"

# ...and the half that push cannot do. An agent that is killed mid-turn stops
# sending events rather than sending a last one, and codex exposes only
# SessionStart, so it can say who it is but never what it is doing. Both are
# read off the pane by `corral scan`, which until now nothing ever called on a
# schedule -- only the pane-exited hook above did, i.e. only when some *other*
# pane happened to die, which is why a dead codex pane could sit on the bar
# claiming to work for a day.
#
# The status bar is that schedule. tmux re-runs this job every status-interval,
# which is far too often to scan panes, so `corral tick` throttles itself to
# CORRAL_TICK_SECS (30s) and returns after one stamp-file read the rest of the
# time. It prints nothing -- it exists for its effect on @corral_rollup, and
# anything it did print would be printed into the status bar.
set -ag status-right "#(~/.local/bin/corral tick)"

# --- prefix + a: go to whatever needs you -----------------------------------
# The rollup says something is waiting and the window glyph says which window,
# but neither can point across sessions -- the window list only has rows for the
# session you are in. This can: `corral list --agents` comes out sorted
# blocked > done > working > idle, so the thing that needs you most is already
# the row under the cursor when the popup opens.
#
# Field 2 is the target (session:window.pane), which is both what the preview
# reads and what switch-client takes. --header-lines=1 keeps corral's column
# header out of the selectable rows. `follow` pins the preview to the bottom of
# the pane's output, so what you see is the prompt the agent is sitting on
# rather than the top of its scrollback.
bind a display-popup -E -w 80% -h 70% "~/.local/bin/corral list --agents | fzf --reverse --header-lines=1 --preview '~/.config/tmux/scripts/peek-preview.sh {2}' --preview-window=down:60%,follow | awk '{print \$2}' | xargs -r tmux switch-client -t"

# Initialize TMUX plugin manager (keep this line at the very bottom of tmux.conf)
run "$HOME/.config/tmux/plugins/tpm/tpm"
