#!/bin/sh
# corral-hook — bridge an agent CLI's hook system into corral's pane state.
#
# Invoked as:  corral-hook <agent> <Event>          (payload JSON on stdin)
# Wired into ~/.claude/settings.json and ~/.codex/hooks.json by
# `corral install-hooks`, which leaves pre-existing entries (herdr's, for one)
# alone.
#
# Why this is split from `corral` itself:
#
#   * The hot events — UserPromptSubmit, PreToolUse, PostToolUse — fire on every
#     tool call of every live agent on the machine. That path stays in /bin/sh
#     and touches nothing but tmux pane options: one read, and a write only when
#     the state actually changed. State that matters solely while the server is
#     up has no business being written to disk hundreds of times a turn.
#
#   * SessionStart / Notification / SessionEnd are rare and carry data that
#     cannot be derived from the environment (session id, transcript path,
#     notification text), so they hand the payload to `corral report`, which
#     writes the durable per-pane record. That record is the only reason
#     `claude --resume <id>` is possible after a reboot: the claude process
#     rewrites its argv to a bare "claude", so neither ps nor tmux-resurrect can
#     recover which conversation a pane was holding.
#
#   * Every path exits 0 and swallows its output. A hook that fails, prints, or
#     blocks is a hook that breaks the agent it is watching.
#
# SubagentStop is deliberately NOT wired. It is a completion event that can fire
# after the main turn has already stopped, so mapping it to a state would revive
# a pane that is correctly sitting idle. (herdr's integration learned the same
# lesson the hard way; the comment in its claude hook says as much.)

set -u

agent=${1:-unknown}
event=${2:-}

STATE_DIR=${CORRAL_STATE_DIR:-$HOME/.local/state/corral}
PIDMAP_DIR=$STATE_DIR/pidpane

# Drain the payload, always, and keep it. Closing stdin unread would hand the
# agent an EPIPE on a path where it is doing nothing wrong.
#
# Every Claude Code hook event carries session_id, transcript_path and cwd --
# the hot ones included, not just SessionStart. This used to throw the hot ones
# away for speed, which meant a pane could only ever acquire an identity at the
# moment its agent started: an agent already running when the hooks were
# installed, or when they were broken, stayed unresumable for its whole life no
# matter how much work it did. Holding the payload in a variable costs the same
# one fork as piping it to /dev/null did, and buys a pane the ability to
# register itself off any event at all.
payload_data=$(cat 2>/dev/null) || payload_data=""

payload=""
cleanup() { [ -n "$payload" ] && rm -f "$payload"; return 0; }
trap cleanup EXIT HUP INT TERM

# `corral report` takes the payload as a file. Write one only when we are
# actually going to call it, so the common path never touches the disk.
payload_file() {
	[ -n "$payload_data" ] || return 1
	if [ -z "$payload" ]; then
		payload=$(mktemp "${TMPDIR:-/tmp}/corral-hook.XXXXXX" 2>/dev/null) || return 1
		printf '%s' "$payload_data" >"$payload" 2>/dev/null || return 1
	fi
	printf '%s\n' "$payload"
}

command -v tmux >/dev/null 2>&1 || exit 0

# --- which pane are we in, and are we the pane's own agent? -----------------
#
# Two questions, one answer, cached together under the agent's pid because
# neither can change for the life of that process. $PPID here is the agent that
# spawned this hook.
#
# The pane: $TMUX_PANE when the agent exports it, otherwise walk up the parent
# chain until a pid matches the process tmux has at the root of a pane.
#
# The ownership: only the pane's own agent gets to speak for the pane. A
# subagent, a background job or a nested claude runs *inside* that agent, and
# its events would otherwise report the pane as working while the session on
# screen sits idle — worse, its SessionStart would stamp the pane's restore
# record with the wrong session id, so a reboot would resume the background job
# instead of the conversation the pane is showing.
#
# Ownership is decided by process shape, not by an environment marker. The
# obvious marker, CLAUDE_CODE_CHILD_SESSION, is inherited: tmux on this machine
# was started from inside a Claude session, so every agent launched by the
# `prefix + \` split binding carries it, and trusting it silenced all five real
# sessions at once. Process shape cannot be inherited by accident: the pane's
# agent is the pane process itself, or its first child when the pane runs a
# shell.
cache=$PIDMAP_DIR/$PPID
pane=""
if [ -r "$cache" ]; then
	read -r pane <"$cache" 2>/dev/null || pane=""
	# "-" is a cached "not this pane's agent, stay quiet".
	[ "$pane" = "-" ] && exit 0
fi

if [ -z "$pane" ]; then
	map=$(tmux list-panes -a -F '#{pane_pid} #{pane_id}' 2>/dev/null) || exit 0
	if [ -n "${TMUX_PANE:-}" ]; then
		pane=$TMUX_PANE
	else
		p=$PPID
		depth=0
		while [ -n "$p" ] && [ "$p" -gt 1 ] 2>/dev/null && [ "$depth" -lt 12 ]; do
			pane=$(printf '%s\n' "$map" | awk -v pid="$p" '$1 == pid { print $2; exit }')
			[ -n "$pane" ] && break
			p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
			depth=$((depth + 1))
		done
	fi
	[ -n "$pane" ] || exit 0

	pane_pid=$(tmux display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null) || pane_pid=""
	owner=""
	if [ -n "$pane_pid" ]; then
		if [ "$PPID" = "$pane_pid" ]; then
			owner=yes
		else
			# Ask who $PPID's parent is, rather than listing the pane
			# process's children and looking for $PPID in them. Same
			# question, but `pgrep -P` cannot answer it: on macOS pgrep
			# omits its own ancestors from the results, and $PPID is the
			# parent of the shell that just ran the pgrep, so it was never
			# in the list. Every real agent takes this branch — the pane
			# runs a shell and the agent is its child — so the check
			# disowned all of them and cached the refusal. A nested agent
			# is a grandchild and still does not qualify.
			[ "$(ps -o ppid= -p "$PPID" 2>/dev/null | tr -d ' ')" = "$pane_pid" ] &&
				owner=yes
		fi
	fi
	mkdir -p "$PIDMAP_DIR" 2>/dev/null || true
	if [ "$owner" = yes ]; then
		printf '%s\n' "$pane" >"$cache" 2>/dev/null || true
	else
		printf -- '-\n' >"$cache" 2>/dev/null || true
		exit 0
	fi
fi

# Event -> state. Anything unmapped is ignored rather than guessed at.
case "$event" in
	SessionStart) state=idle ;;
	UserPromptSubmit | PreToolUse | PostToolUse) state=working ;;
	PreCompact) state=working ;;
	Notification) state=blocked ;;
	Stop) state=done ;;
	SessionEnd) state=gone ;;
	*) exit 0 ;;
esac

# Rare events carry data worth parsing; hand them to the bash side and stop.
case "$event" in
	SessionStart | Notification | SessionEnd)
		corral report --pane "$pane" --agent "$agent" --state "$state" \
			--event "$event" --payload "$(payload_file)" >/dev/null 2>&1 || true
		exit 0
		;;
esac

# --- hot path ---------------------------------------------------------------
# A whole turn's worth of PostToolUse events collapses into a single tmux round
# trip each, because the write only happens on a real transition.
#
# Two timestamps, and they answer different questions. @corral_since is when the
# state last changed ("working for 40 minutes"). @corral_seen_at is when an event
# last arrived, i.e. proof of life — without it a long turn is indistinguishable
# from an agent that was killed mid-tool-call, and readers would flag every real
# 40-minute turn as stale. It is refreshed at most once a minute so a chatty turn
# still costs one tmux round trip per event, not two.
prev=$(tmux display-message -p -t "$pane" '#{@corral_state}|#{@corral_seen_at}|#{@corral_session}' 2>/dev/null) || exit 0
now=$(date +%s)

# Same round trip, third field: has this pane got an identity yet? If not, the
# event in hand is carrying one, and a pane with no session id is a pane that
# cannot be resumed after a reboot. Register it through `corral report` so the
# record format stays in one place. Taken at most once per session per pane --
# report sets @corral_session, and every event after this reads it here and
# falls straight through to the fast path below.
sid=${prev##*|}
prev=${prev%|*}
if [ -z "$sid" ] && [ -n "$payload_data" ]; then
	pf=$(payload_file) && {
		corral report --pane "$pane" --agent "$agent" --state "$state" \
			--event "$event" --payload "$pf" >/dev/null 2>&1 || true
		exit 0
	}
fi

if [ "${prev%%|*}" = "$state" ]; then
	seen=${prev##*|}
	case "$seen" in
		'' | *[!0-9]*) seen=0 ;;
	esac
	[ "$((now - seen))" -ge 60 ] &&
		tmux set -p -t "$pane" @corral_seen_at "$now" 2>/dev/null
	exit 0
fi

# @corral_source is part of the same round trip, and it is not decoration:
# `corral scan` reads it to know this pane has an agent that speaks for itself,
# and leaves the state alone while the hook keeps talking.
tmux set -p -t "$pane" @corral_state "$state" \; \
	set -p -t "$pane" @corral_since "$now" \; \
	set -p -t "$pane" @corral_seen_at "$now" \; \
	set -p -t "$pane" @corral_agent "$agent" \; \
	set -p -t "$pane" @corral_source hook \; \
	set -p -t "$pane" @corral_detail "" 2>/dev/null || exit 0

# Roll the pane states up to a window-level option so a status-bar format can
# show one glyph per window without shelling out on every redraw.
best=""
best_rank=0
for s in $(tmux list-panes -t "$pane" -F '#{@corral_state}' 2>/dev/null); do
	case "$s" in
		blocked) r=4 ;;
		done) r=3 ;;
		working) r=2 ;;
		idle | starting) r=1 ;;
		*) r=0 ;;
	esac
	[ "$r" -gt "$best_rank" ] && {
		best_rank=$r
		best=$s
	}
done
tmux set -w -t "$pane" @corral_win_state "$best" 2>/dev/null || true

exit 0
