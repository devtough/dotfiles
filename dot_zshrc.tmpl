{{- /*
  Dispatcher. The two macs run genuinely different shells — rss-mac is
  oh-my-zsh + powerlevel10k, sonbox is a minimal homebrew-only setup — so the
  bodies live in .chezmoitemplates/ rather than in one big if/else here.
  Ignored entirely on omarchy (bash); see .chezmoiignore.tmpl.
*/ -}}
{{- if eq .profile "sonbox" -}}
{{-   template "zshrc-sonbox" . -}}
{{- else -}}
{{-   template "zshrc-rss-mac" . -}}
{{- end -}}
